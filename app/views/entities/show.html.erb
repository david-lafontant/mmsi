<%if notice%>
  <p style="color: green"><%= notice %></p>
<%end%>
<%= render @entity %>
<div>
  <%= link_to "Edit this entity", edit_entity_path(@entity), class: "btn btn-warning" %> |
  <%= link_to "Back to entities", entities_path, class: "btn btn-success" %>
  <%= button_to "Destroy this entity", @entity, method: :delete, class: "btn btn-danger" %>
</div>
